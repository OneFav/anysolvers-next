{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description_file": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        },
        "aggregation": {
          "const": "mean_if_all_valid"
        }
      },
      "required": [
        "name",
        "direction",
        "aggregation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "version",
    "description_file",
    "objective"
  ],
  "additionalProperties": false
}
