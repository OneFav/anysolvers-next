{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "valid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "object"
          },
          "solution": {},
          "actions": {
            "type": "array"
          },
          "expected": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "metrics": {
                "type": "object"
              },
              "trace": {}
            },
            "required": [
              "score",
              "metrics"
            ],
            "additionalProperties": false
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "case",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "invalid_inputs": {
      "type": "array",
      "minItems": 1
    },
    "invalid_solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "object"
          },
          "solution": {},
          "name": {
            "type": "string"
          },
          "error_contains": {
            "type": "string"
          }
        },
        "required": [
          "case",
          "solution"
        ],
        "additionalProperties": false
      }
    },
    "invalid_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "object"
          },
          "actions": {
            "type": "array",
            "minItems": 1
          },
          "name": {
            "type": "string"
          },
          "error_contains": {
            "type": "string"
          }
        },
        "required": [
          "case",
          "actions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "valid",
    "invalid_inputs"
  ],
  "additionalProperties": false
}
