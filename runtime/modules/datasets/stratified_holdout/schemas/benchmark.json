{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "protocol": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "function"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "episode"
            },
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "action_wall_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "max_steps",
            "action_wall_s"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evaluator_file": {
      "type": "string",
      "minLength": 1
    },
    "baseline_file": {
      "type": "string",
      "minLength": 1
    },
    "tests_file": {
      "type": "string",
      "minLength": 1,
      "description": "Initialization-relative path to a JSON fixtures object matching schemas/fixtures.json. This is not a Python test script."
    },
    "support_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "benchmark_id",
    "task_id",
    "protocol",
    "evaluator_file",
    "baseline_file",
    "tests_file",
    "support_files"
  ],
  "additionalProperties": false
}
