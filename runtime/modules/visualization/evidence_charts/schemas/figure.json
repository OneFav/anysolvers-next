{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "figure_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "image_file": {
      "type": "string",
      "minLength": 1
    },
    "data_file": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "figure_id",
    "image_file",
    "data_file",
    "evaluation_ids"
  ],
  "additionalProperties": false
}
