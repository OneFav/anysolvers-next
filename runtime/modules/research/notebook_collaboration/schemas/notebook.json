{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "learned": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "failed_or_uncertain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "next_iteration_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "session_id",
    "candidate_id",
    "evidence_ids",
    "learned",
    "failed_or_uncertain",
    "next_iteration_id"
  ],
  "additionalProperties": false
}
