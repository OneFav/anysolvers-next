{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "type": {
      "enum": [
        "result",
        "hypothesis",
        "insight",
        "error",
        "observation"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "parent_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "session_id",
    "type",
    "claim",
    "candidate_id",
    "evidence_ids",
    "parent_findings"
  ],
  "additionalProperties": false
}
