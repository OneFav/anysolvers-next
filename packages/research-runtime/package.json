{
  "name": "@onefav/research-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Method-neutral DSH research execution and durable run identities",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/index.js",
    "./service": "./lib/service.js",
    "./command": "./lib/command.js",
    "./ui": "./lib/ui.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./python": "./python/research_runtime/__init__.py"
  },
  "files": [
    "lib",
    "python",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1"
  }
}
